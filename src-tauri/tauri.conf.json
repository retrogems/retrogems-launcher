{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RetroGems",
  "version": "0.2.1",
  "identifier": "fr.retrogems.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "publisher": "RetroGems",
    "copyright": "RetroGems",
    "shortDescription": "RetroGems : actu jeux vidéo, jeux du Studio et portages PC en 1 clic",
    "longDescription": "L'application gratuite de RetroGems : toute l'actu du jeu vidéo, les jeux RetroGems Studio, la communauté, et l'installation des portages PC natifs (recompilations et décompilations) en 1 clic.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "French",
          "English",
          "Spanish"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "retrogems"
        ]
      }
    }
  }
}
